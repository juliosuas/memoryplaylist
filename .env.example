# Memory Playlist frontend (Lovable/Vite)
# Set these in Lovable Project Settings → Environment Variables.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-or-publishable-key
VITE_STRIPE_PAYMENT_LINK=https://buy.stripe.com/your-memory-playlist-link

# Supabase Edge Functions only — set as a Supabase secret, never expose with VITE_.
# The app still generates a local playlist if this key is missing or the AI gateway fails.
LOVABLE_API_KEY=your-lovable-ai-gateway-key
